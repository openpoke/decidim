<% if add %>
  <%= link_to new_two_factor_authentication_totp_authenticator_path, class: "button button__xs button__transparent-secondary" do %>
    <%= icon two_factor_method.icon, class: "fill-current" %>
    <span><%= t("decidim.two_factor.setup.totp.title") %></span>
  <% end %>
<% else %>
  <%= render layout: "decidim/two_factor/setup/row", locals: {
        icon_name: two_factor_method.icon,
        title: t("decidim.two_factor.setup.totp.title"),
        description: two_factor_usage(authenticator)
      } do %>
    <%= button_to t("decidim.two_factor.setup.remove"),
                  two_factor_authentication_authenticator_path(authenticator),
                  method: :delete,
                  class: "button button__xs button__transparent-secondary",
                  data: { confirm: t("decidim.two_factor.setup.totp.remove_confirm") } %>
  <% end %>
<% end %>
